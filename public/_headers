/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Embed cards must be iframe-able from anywhere — that's the whole point.
# Cloudflare _headers can't remove a header set by an earlier matching rule,
# so the global X-Frame-Options: DENY still appears alongside ALLOWALL. The
# Content-Security-Policy: frame-ancestors directive overrides XFO entirely
# in all modern browsers (CSP Level 2 §6.1), so framing works regardless.
/embed/*
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  Cache-Control: public, max-age=300
